+def test_unknown_memory_flag_is_flagged(tmp_path, monkeypatch):
+    """Memory commands are always registered, so their real flags must be
+    validated just like every other served CLI command.
+    """
+    fake_skill = tmp_path / "skill.md"
+    fake_skill.write_text(
+        "Run `wren memory recall --definitely-invalid value`.\n",
+        encoding="utf-8",
+    )
+
+    module = sys.modules[__name__]
+    monkeypatch.setattr(module, "_SKILLS_CONTENT", tmp_path)
+    monkeypatch.setattr(module, "_DOCS_CONTENT", tmp_path / "_empty_docs")
+    monkeypatch.setattr(module, "_ASK_TEMPLATES", tmp_path / "_empty_ask")
+    monkeypatch.setattr(module, "_DISCOVERY_STUB", tmp_path / "_no_stub.md")
+
+    problems = _findings()
+    assert any(
+        "unknown flag '--definitely-invalid' for 'wren memory recall'" in problem
+        for problem in problems
+    ), problems
